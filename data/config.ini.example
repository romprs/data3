[message]
; Путь к файлу со списком задач. Каждая непустая строка — отдельная задача.
; Файл может перегенерироваться внешним скриптом (например, результатом
; запроса к базе данных). Если оставить значение пустым — блок "Задачи" в
; окне не показывается.
tasks_file = /etc/startup-notice/tasks.txt

; Путь к файлу с фразами "мысль дня". Каждая непустая строка — отдельная
; фраза; при каждом показе окна случайно выбирается одна из них. Если
; оставить значение пустым — используется встроенная подсказка админу.
phrases_file = /etc/startup-notice/phrases.txt

[appearance]
; Каталог с фоновыми изображениями (.jpg/.jpeg/.png). При каждом показе
; окна случайно выбирается один файл и масштабируется под размер экрана
; (кроп по центру, без искажения пропорций). Если оставить значение
; пустым — используется тёмный фон без изображения.
background_dir = /etc/startup-notice/backgrounds
font_size = 16

[behavior]
; Сколько секунд блокировки приходится на одну задачу из tasks_file.
; Итоговое время блокировки = seconds_per_task * количество задач (нет
; задач — окно сразу разблокировано, без периода ожидания). Действует,
; только если lock_duration_seconds ниже не задан.
seconds_per_task = 5

; Фиксированное время в секундах, в течение которого окно нельзя закрыть/
; свернуть/переключить — если раскомментировать, полностью заменяет собой
; расчёт по числу задач (seconds_per_task выше игнорируется). 0 — полностью
; отключает показ окна (сервис завершается сразу, без вывода).
;lock_duration_seconds = 30
