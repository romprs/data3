[message]
title = Уведомление
text = Текст сообщения администратора...
; Опционально: длинный/многострочный текст можно вынести в отдельный файл
; text_file = /etc/startup-notice/message.txt

[behavior]
; Время в секундах, в течение которого окно нельзя закрыть/свернуть/переключить
lock_duration_seconds = 30
font_size = 16
